{
  "manifest_version": 3,
  "name": "Gentle Control Room — ChatGPT Activity",
  "version": "0.9.0",
  "description": "Opt-in local coding evidence, recurring pattern detection, and approved Codex analysis.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "nativeMessaging"
  ],
  "action": {
    "default_title": "Open ChatGPT Activity sidebar"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://api.github.com/*"
  ]
}
