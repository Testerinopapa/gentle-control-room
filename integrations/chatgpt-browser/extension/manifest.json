{
  "manifest_version": 3,
  "name": "Gentle Control Room — ChatGPT Activity",
  "version": "0.3.0",
  "description": "Opt-in local ChatGPT session and coding-signal metadata for Gentle Control Room.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "nativeMessaging",
    "sidePanel"
  ],
  "action": {
    "default_title": "Open ChatGPT Activity sidebar"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ]
}
